# ── Required ──────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
JWT_SECRET_KEY=your_long_random_secret_here
DATABASE_URL=postgresql+asyncpg://scylla:scylla@localhost:5432/nimrouter
REDIS_URL=redis://localhost:6379

# ── Optional: JWT ─────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60

# ── Optional: Public demo (ephemeral per-login accounts) ──────────────────────
# For a publicly-published demo login. When enabled, every login with the seed
# demo credentials mints a FRESH isolated throwaway account (demo_<hex>) instead
# of sharing one — two reviewers get two separate sandboxes (own memory/files/
# conversations), each auto-purged when idle. Default OFF → byte-identical to a
# normal single shared demo account (the seed logs in as itself, nothing minted).
# No DB migration: ephemerals are marked by the `demo_` username prefix.
# Toggle live (no restart): PUT /admin/env/DEMO_EPHEMERAL_ENABLED then reload.
# DEMO_EPHEMERAL_ENABLED=false
# DEMO_SEED_USERNAME=demo              # the published login that triggers a mint
# DEMO_PER_ACCOUNT_CAP_USD=1.0         # per-sandbox spend cap
# DEMO_PER_ACCOUNT_WINDOW_DAYS=1       # per-sandbox cost window
# DEMO_GLOBAL_CAP_USD=10.0             # total spend across ALL demo_* in the window
# DEMO_GLOBAL_WINDOW_HOURS=24          # rolling window for the global pool
#   Pool exhausted → new demo logins refused (503) AND already-minted sandboxes
#   blocked from further spend (402). Bounds real NIM cost regardless of traffic.
# DEMO_IDLE_TTL_HOURS=2                # reap a sandbox after this much inactivity
# DEMO_REAP_INTERVAL_MIN=30           # how often the reaper sweeps (scheduler)
# DEMO_MAX_LIVE_ACCOUNTS=0            # 0 = off; >0 also caps concurrent demo_* rows

# ── Optional: Postgres (used by docker-compose) ───────────────────────────────
POSTGRES_USER=scylla
POSTGRES_PASSWORD=scylla
POSTGRES_DB=nimrouter

# ── Optional: NIM ─────────────────────────────────────────────────────────────
NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
MODEL_LLAMA=nvidia/llama-3.1-nemotron-nano-8b-v1
MODEL_CODER=qwen/qwen2.5-coder-32b-instruct
MODEL_REASONING=nvidia/llama-3.1-nemotron-70b-instruct
MODEL_VISION=meta/llama-3.2-90b-vision-instruct

# ── Optional: Image OCR (CPU PaddleOCR) ───────────────────────────────────────
# IMAGE_OCR_ENABLED=true extracts text from uploaded/pasted images via CPU
# PaddleOCR at upload (Library) and on inline chat paste, then embeds the OCR
# text for semantic search alongside text chunks — no VLM/MODEL_VISION call.
# Default false (the home-server chat model is text-only). Requires the
# paddlepaddle/paddleocr/Pillow deps from requirements.txt.
IMAGE_OCR_ENABLED=false

# ── Optional: Voice Input (STT) ───────────────────────────────────────────────
# VOICE_ENABLED=true exposes POST /api/transcribe (mic → audio → text injected
# into the chat input) and shows the frontend mic button. Default false → endpoint
# returns 503 and the button stays hidden.
# ASR_BACKEND selects the transcriber: "stub" (ships now, returns a placeholder —
# no model) → "faster_whisper" when the real ASR lands (QUEUE.md Q2, box-blocked;
# needs the faster-whisper dep + an ffmpeg system binary to decode webm/opus).
# ASR_MODEL / ASR_LANGUAGE are consumed by the real backend (ignored by the stub).
VOICE_ENABLED=false
ASR_BACKEND=stub                                          # stub | faster_whisper
ASR_MODEL=base.en
ASR_LANGUAGE=                                             # blank = auto-detect

# ── Optional: Backend switch (NIM ⇄ self-hosted llama.cpp home server) ─────────
# LLM_BACKEND flips the whole app between the paid NIM test backend and the local
# llama.cpp/Mixtral stack with ONE var. Default "nim" → behaves exactly as today.
# Set "homeserver" to repoint endpoints + collapse to one Mixtral + size context to
# 32k + drop the NVIDIA_API_KEY requirement — no need to hand-edit the vars above.
# Toggle live without a restart: PUT /admin/env/LLM_BACKEND then POST /admin/env/reload.
# LLM_BACKEND=nim                                          # nim | homeserver
# HOMESERVER_CHAT_URL=http://llamacpp:8080/v1/chat/completions
# HOMESERVER_EMBED_URL=http://llamacpp-embed:8081/v1/embeddings
# HOMESERVER_MODEL=mixtral                                 # must match llama.cpp --alias
# HOMESERVER_EMBED_MODEL=bge-large-en-v1.5                 # 1024-d → no re-embed
# HOMESERVER_CTX=32768                                     # served context window

# ── Optional: Home-server serving (Q1 — llama.cpp/GGUF, profile: homeserver) ───
# Off by default. Start with: docker compose --profile homeserver up -d
# Then set LLM_BACKEND=homeserver (above) to leave NIM behind — preferred over the
# manual repoint below, which is the lower-level equivalent:
#   NIM_URL=http://llamacpp:8080/v1/chat/completions
#   NIM_EMBEDDING_URL=http://llamacpp-embed:8081/v1/embeddings
# Drop GGUF weights into backend/storage/models/ first. All optional (compose has defaults):
# LLAMACPP_MODEL=mixtral-8x7b-instruct-v0.1.Q4_K_M.gguf
# LLAMACPP_CTX=32768            # served context window (set CONTEXT_WINDOWS to match in config.py)
# LLAMACPP_NGL=999              # gpu layers to offload (all)
# LLAMACPP_PARALLEL=2           # concurrent slots
# EMBED_MODEL=bge-large-en-v1.5-q8_0.gguf
# EMBED_POOLING=cls             # bge uses CLS pooling, keep 1024-d → no re-embed
# CPU validation (tool_calls gate, no GPU): add -f docker/docker-compose.homeserver.cpu.yml
# LLAMACPP_CPU_MODEL=mistral-7b-instruct-v0.3.Q4_K_M.gguf

# ── Optional: Endpoint failover (chat only) ───────────────────────────────────
# Health-gated primary→NIM selection at the call layer, for the Oracle+homelab
# topology: prefer the homelab endpoint over WireGuard while it is up, fall back
# to NIM when it is not — no manual env flip. Distinct from LLM_BACKEND (a static
# operator switch) and from the model fallback chain (same endpoint, other model).
# Off by default → byte-identical to no failover at all: no probe, no Redis touch.
# CHAT ONLY — never embeddings. Failing an embed over to a different embedder
# mixes two vector spaces and silently poisons retrieval; that is a re-embed, not
# a failover. Any non-200 from the primary demotes the ENDPOINT for LLM_HEALTH_TTL
# seconds and never the model's circuit breaker.
# LLM_FAILOVER_ENABLED=false
# LLM_PRIMARY_URL=http://10.8.0.2:8080/v1/chat/completions  # full chat-completions URL
# LLM_HEALTH_TTL=15                                         # s, cache the health verdict
# LLM_HEALTH_TIMEOUT=2                                      # s, /models probe timeout
# NVIDIA_API_KEY is NEVER sent to LLM_PRIMARY_URL. Leave the key below empty for a
# plain llama.cpp (needs no auth); set it only if you started the primary with its
# own --api-key.
# LLM_PRIMARY_API_KEY=

# ── Optional: Reliability ─────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_RETRIES=2
MAX_CONCURRENT_REQUESTS=10
AI_TIMEOUT=10
# STREAM_READ_TIMEOUT is PER-CHUNK — it resets on every token, so it cannot bound a
# model that trickles instead of failing. The three budgets below are the real ceiling.
# 0 disables a budget.
STREAM_TOTAL_TIMEOUT=120      # seconds, one model connection
STREAM_TURN_BUDGET=300        # seconds, whole user turn (all tool iterations + fallbacks)
STREAM_MAX_TURN_TOKENS=16000  # output tokens accumulated over the whole turn

# ── Optional: Cache ───────────────────────────────────────────────────────────
USE_REDIS=true

# ── Optional: Storage ─────────────────────────────────────────────────────────
STORAGE_DIR=storage/files

# ── Optional: Observability ───────────────────────────────────────────────────
OBSERVABILITY_ENABLED=true
METRICS_STREAM=metrics_stream
METRICS_CONSUMER_GROUP=metrics_workers
METRICS_STREAM_MAXLEN=10000
METRICS_BATCH_SIZE=100
METRICS_WORKER_BLOCK_MS=5000
METRICS_WORKER_IDLE_SLEEP=0.5

# ── Optional: Prometheus ──────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9100

# ── Optional: Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Neo4j (graph memory) ──────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Scheduled Backup ──────────────────────────────────────────────────────────
BACKUP_SCHEDULE=0 2 * * *

# ── Optional: Web Search ──────────────────────────────────────────────────────
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BACKEND=searxng   # searxng | tavily
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=

# ── Optional: Daily/Weekly Digest ────────────────────────────────────────────
DIGEST_ENABLED=false
DIGEST_SCHEDULE=0 8 * * 1   # cron: default Monday 8 AM UTC

# ── Optional: SMTP (for digest email delivery) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Require STARTTLS on non-465 ports (fail-closed). Set false ONLY for a plain dev
# relay like MailHog — never for a real provider.
SMTP_STARTTLS=true

# ── Optional: Notifications (out-of-UI: email + web push) ─────────────────────
# Per-user opt-in (UserNotificationPreferences) for digest, scheduled-prompt
# completion, and new-insight notifications. Email reuses the SMTP_* vars above.
# Web push needs VAPID keys (generate: `vapid --gen` or the pywebpush helper);
# leave blank to disable push (the channel no-ops, the UI toggle is hidden).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_RATE_LIMIT=5     # max notifications per user per window
NOTIFICATION_RATE_WINDOW=60   # rate-limit window in seconds

# ── External Integrations (OAuth connectors) ──────────────────────────────────
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET=
INTEGRATION_REDIRECT_BASE=http://localhost:8000
# Google OAuth app (Drive + Calendar + Gmail share one app) — console.cloud.google.com
# Calendar connector reuses these vars; in the Google Cloud project enable the
# Calendar API and add scope https://www.googleapis.com/auth/calendar.events to
# the consent screen (config only — no new env vars).
# Gmail connector (read-only) also reuses these vars; enable the Gmail API and add
# scope https://www.googleapis.com/auth/gmail.readonly to the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notion OAuth app — notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# GitHub OAuth app — github.com/settings/applications
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Which connectors the UI offers an OAuth button for (CSV). EMPTY = all stubbed ("Soon").
# Served to the frontend at runtime by GET /api/integrations/available, so flipping this
# + POST /admin/env/reload exposes connectors with NO frontend rebuild and no restart.
# Does NOT deactivate existing ExternalSource rows — it only controls the connect button.
# Keep it OUT of the compose environment: block (compose env outranks .env).
ENABLED_CONNECTOR_TYPES=
