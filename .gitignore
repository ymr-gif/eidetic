# Environment
# Catch-all: every .env variant is ignored, .env.example is the one exception.
# A name-by-name list let a timestamped backup holding live keys sit untracked
# AND un-ignored on a public repo (2026-07-21) — one `git add -A` from publishing it.
.env*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Node
node_modules/
dist/
build/
.cache/

# Storage (user uploads + DB dumps — contain user data, never commit)
backend/storage/files/
backend/storage/backups/
backend/storage/models/

# Generated artifacts / tool caches (regenerated locally, never commit)
graphify-out/
**/graphify-out/
.opencode/
.wwebjs_cache/

# Logs
*.log

# DB / editor
*.sqlite3
.DS_Store
.idea/
.vscode/

# Alembic cache
backend/alembic/versions/__pycache__/

# SearXNG — auto-generated config contains secret_key
docker/searxng/settings.yml

# IDE / AI tool configs
.cursor/
opencode.json
design_handoff_ultrakill_reskin/

# AI tool files (instructions, memory, handoff protocols)
CLAUDE.md
**/CLAUDE.md
CURSOR_IDE_MEMORY.md
HANDOFF_ARCHIVE.md
HANDOFF_PROTOCOL.md
SKILL.md
**/SKILL.md

# Internal dev notes / scaffolding — repo is public, these never ship
# (untracked 2026-07-06; supersedes the 2026-06-28 force-track of HANDOFF.md + QUEUE.md)
BUGS.md
QUEUE.md
HANDOFF.md
SUMMARY.md
COMMANDS.md
plans/
tests/VERIFICATION.md
backend/tests/VERIFICATION_LAUNCH.md
backend/tests/latch/RUNLOG.md
backend/tests/latch/rich_full_logs/
backend/tests/latch/*.jsonl
backend/tests/latch/scores*.txt

# Timestamped .env backups (contain live secrets — repo is public)
.env.bak.*
.env.*.bak
